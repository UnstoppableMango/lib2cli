// The Go library the end-to-end test generates, builds and runs a shim
// for. Its source is in lib/.
package greet

import "../../../lib/lib2cli.tdl" as lib

type GreetRequest {
  name: string
  excited: bool
}

type RepeatRequest {
  word: string
  times: int
}

type DivideRequest {
  a: float64
  b: float64
}

type CountRequest {
  in: lib.Stream
}

type Stats {
  lines: int
  bytes: int
}

type UpperRequest {
  in: lib.Stream
}

type TagRequest {
  name: string
  tags: List<string>
  labels: Map<string, string>
  note: string?
}

type Tagged {
  label: string
  note: string?
}

type VersionRequest {}

type Greet {
  greet: lib.Fn<GreetRequest, string>
  repeat: lib.Fn<RepeatRequest, string>
  divide: lib.Fn<DivideRequest, float64>
  count: lib.Fn<CountRequest, Stats>
  upper: lib.Fn<UpperRequest, lib.Stream>
  tag: lib.Fn<TagRequest, Tagged>
  version: lib.Fn<VersionRequest, lib.Text>
}

target lib2cli for greet {
  go("example.com/greet", "v0.1.0")
  Greet => cli
  Greet.tag => whole
}
