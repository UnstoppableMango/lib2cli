package mdx

import "../../../prelude/lib2cli.tdl" as lib

type CompileOptions {
  jsx: bool?
  outputFormat: string?
}

type CompileRequest {
  file: lib.Text
  options: CompileOptions?
}

type Mdx {
  compile: lib.Fn<CompileRequest, lib.Text>
}

target lib2cli for mdx {
  npm("@mdx-js/mdx", "3.1.0")
  Mdx => cli
}
