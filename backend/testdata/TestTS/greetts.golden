      { name: "in", flag: "in", type: { kind: "stream" } },
    ],
    async call(a, io) {
      const res = await lib.upper(a[0] as Readable);
      await writeStream(io, res);
    },
  },
  {
    name: "tag",
    params: [
      { name: "name", flag: "name", type: { kind: "string" } },
      { name: "tags", flag: "tags", type: { kind: "list", elem: { kind: "string" } } },
      { name: "labels", flag: "labels", type: { kind: "map", elem: { kind: "string" } } },
      { name: "note", flag: "note", type: { kind: "option", elem: { kind: "string" } } },
      { name: "options", flag: "options", type: { kind: "option", elem: { kind: "object" } } },
    ],
    async call(a, io) {
      const res = await lib.tag({ name: a[0] as string, tags: a[1] as Array<string>, labels: a[2] as Record<string, string>, note: a[3] as string | undefined, options: a[4] as NonNullable<Parameters<typeof lib.tag>[0]>["options"] });
      await writeJSON(io, res);
