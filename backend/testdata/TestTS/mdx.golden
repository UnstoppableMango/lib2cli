-- package.json --
{
  "name": "mdx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "mdx": "dist/main.js"
  },
  "scripts": {
    "build": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
-- tsconfig.json --
{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
-- src/main.ts --
#!/usr/bin/env node
// Code generated by lib2cli. DO NOT EDIT.

import * as lib from "@mdx-js/mdx";
import { run, writeText } from "./shim.js";

await run("mdx", [
  {
    name: "compile",
    params: [
      { name: "file", flag: "file", type: { kind: "text" } },
      { name: "options", flag: "options", type: { kind: "option", elem: { kind: "object" } } },
    ],
    async call(a, io) {
      const res = await lib.compile(a[0] as string, a[1] as Parameters<typeof lib.compile>[1]);
      await writeText(io, res);
    },
  },
]);
